# Pilotwardrobe API: copy to .env and fill in. Placeholders only; never commit real secrets.
# Local quick start: drivers below default to safe fakes (log/fake/local/sandbox).

APP_NAME=Pilotwardrobe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The Vue SPA origin (links in emails, CORS, OAuth redirects).
APP_FRONTEND_URL=http://localhost:5173
API_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Comma-separated proxy IPs/CIDRs in front of the app (load balancer); * to trust all.
TRUSTED_PROXIES=

# --- Database (PostgreSQL 15+) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pilotwardrobe
DB_USERNAME=pilotwardrobe
DB_PASSWORD=change-me
DB_SSLMODE=prefer

# --- Redis (cache, queues, locks, rate limits) ------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=pw_
# Production: redis (+ Horizon). Local without workers: sync.
QUEUE_CONNECTION=sync
# Long-running jobs (exports, broadcasts). Production: redis-long.
QUEUE_LONG_CONNECTION=sync
REDIS_QUEUE_RETRY_AFTER=180

# --- Sessions / Sanctum / CORS ----------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# e.g. .pilotwardrobe.com so api. and www. share the session cookie.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Hosts that receive cookie (stateful) auth; everyone else gets bearer tokens.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
# Defaults to APP_FRONTEND_URL; comma-separated for several origins.
CORS_ALLOWED_ORIGINS=
AUTH_TOKEN_TTL_MINUTES=60

# --- Staff / admin console ---------------------------------------------------
STAFF_EMAIL_DOMAIN=pilotwardrobe.com
# Password login for staff is for local/dev only; production uses Google + passkeys.
STAFF_PASSWORD_LOGIN=false
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="Pilotwardrobe Control Tower"
API_DOCS_PUBLIC=false
OPS_ALERT_EMAIL=
HORIZON_PATH=horizon

# --- Email (ZeptoMail) ---------------------------------------------------------
# log | zeptomail
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_BOUNCE_ADDRESS=
TRUST_SAFETY_EMAIL=trust@example.com

# --- SMS: Termii primary, Twilio failover ------------------------------------
# Ordered list: termii,twilio | log
SMS_PROVIDERS=log
TERMII_API_KEY=
TERMII_SENDER_ID=Pilotwrdrb
TERMII_CHANNEL=dnd
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- WhatsApp Cloud API -------------------------------------------------------
# cloud | log
WHATSAPP_DRIVER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Push (Firebase Cloud Messaging HTTP v1) ----------------------------------
# fcm | log
PUSH_DRIVER=log
FIREBASE_PROJECT_ID=
# Service-account JSON: a file path, inline JSON, or base64 of the JSON.
FIREBASE_CREDENTIALS=

# --- Media (Cloudinary) --------------------------------------------------------
# cloudinary | local
MEDIA_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=pilotwardrobe
CLOUDINARY_SECURE_URL=true

# --- Payments --------------------------------------------------------------------
# Enables the `sandbox` gateway (instant fake payments). Never true in production.
PAYMENTS_SANDBOX_ENABLED=true
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- KYC (Prembly / IdentityPass) ---------------------------------------------
# prembly | fake
KYC_DRIVER=fake
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_WEBHOOK_SECRET=
PREMBLY_BASE_URL=https://api.prembly.com

# --- Social sign-in -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Staff Google sign-in (ID token audience); defaults to GOOGLE_CLIENT_ID.
GOOGLE_STAFF_CLIENT_ID=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"
